{
  "name": "coelhor-iac",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "compile": "tsc --pretty",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "lint": "eslint src/*.ts & eslint src/**/*.ts",
    "lint:fix": "eslint --fix src",
    "prettier": "prettier --check src/*.ts & prettier --check src/**/*.ts",
    "prettier:fix": "prettier --write src/*.ts & prettier --write src/**/*.ts",
    "test": "jest",
    "test:fix": "jest --updateSnapshot"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-go-alpha": "^2.212.0-alpha.0",
    "aws-cdk-lib": "^2.212.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21",
    "typescript-eslint": "^8.40.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "aws-cdk": "^2.1026.0",
    "eslint": "^9.34.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "printWidth": 120
  },
  "engines": {
    "npm": "please-use-yarn",
    "node": ">=18",
    "yarn": "~1.22.0 <2"
  }
}
